:[5.5,0,-3.7080992435478315],"step":4,"color":"#fbbf24"},{"type":"line","id":"PQ","a":[5.5,0,3.7080992435478315],"b":[5.5,0,-3.7080992435478315],"step":5,"color":"#f472b6"},{"type":"line","id":"AC","a":[8,0,0],"b":[0,6,0],"step":3,"color":"#34d399"}]},"2026-09-28":{"scale":14,"answer":"④ √2/3","prompt":"원점 O를 중심으로 하고 반지름 6인 구 위 A,B에 대해, 선분 OA 위의 OC=4인 점 C에서 BC∥xy평면이다. OA,AB가 xy평면과 이루는 예각 α,β에 대해 sinα=3sinβ. △OAB의 xy평면 정사영이 직각삼각형일 때 평면 OAB와 xy평면 사이 예각 θ의 cosθ를 구하라.","steps":[["구와 벡터 배치","OA=OB=6, C=(2/3)A이고 BC가 수평이므로 B의 높이는 A의 2/3이다.","z_B=(2/3)z_A"],["기울기 조건","sinα=z_A/6, sinβ=(z_A/3)/AB에 sinα=3sinβ를 대입한다.","AB=6"],["OAB는 정삼각형","세 변이 모두 6이므로 OA·OB=(36+36−36)/2=18이다.","OA·OB=18"],["정사영의 직각 조건","수평 성분을 a,b라고 하면 a·b=18−(2/3)z_A². 정사영의 직각은 O에서만 가능하다.","a·b=0 ⇒ z_A²=27"],["실제 좌표 구성","회전하여 A=(3,0,3√3), B=(0,2√6,2√3)으로 둘 수 있다.","OA=OB=AB=6, OC=4, BC는 수평"],["면적 비율로 이면각 계산","xy평면에 투영된 △OAB 넓이는 3√6, 원래 넓이는 9√3이다.","cosθ=(3√6)/(9√3)=√2/3 → ④"]],"objects":[{"type":"sphere","id":"S","c":[0,0,0],"r":6,"step":0,"color":"#60a5fa"},{"type":"plane","id":"xy평면","c":[0,0,0],"n":[0,0,1],"size":13,"step":0,"color":"#a78bfa"},{"type":"point","id":"O","p":[0,0,0],"step":0,"color":"#dbeafe"},{"type":"point","id":"A","p":[3,0,5.196152422706632],"step":1,"color":"#fbbf24"},{"type":"point","id":"B","p":[0,4.898979485566356,3.4641016151377544],"step":1,"color":"#fbbf24"},{"type":"point","id":"C","p":[2,0,3.4641016151377544],"step":1,"color":"#fbbf24"},{"type":"line","id":"OA","a":[0,0,0],"b":[3,0,5.196152422706632],"step":0,"color":"#7dd3fc"},{"type":"line","id":"OB","a":[0,0,0],"b":[0,4.898979485566356,3.4641016151377544],"step":1,"color":"#7dd3fc"},{"type":"line","id":"AB","a":[3,0,5.196152422706632],"b":[0,4.898979485566356,3.4641016151377544],"step":1,"color":"#7dd3fc"},{"type":"line","id":"BC","a":[0,4.898979485566356,3.4641016151377544],"b":[2,0,3.4641016151377544],"step":2,"color":"#34d399"},{"type":"polygon","id":"OAB","pts":[[0,0,0],[3,0,5.196152422706632],[0,4.898979485566356,3.464101